Algoritmo Practica7_a2253332323_Ejercicio5
	
    Definir num Como Entero
	
    Escribir "Introduce un numero"
    Leer num
	
    Si (num > 0) Y (num MOD 2 = 0) Entonces
        Escribir "Es positivo y Par"
    Sino
        Si (num > 0) Y (num MOD 2 <> 0) Entonces
            Escribir "Es positivo e Impar"
        Sino
            Si (num < 0) Y (num MOD 2 = 0) Entonces
                Escribir "Es Negativo y Par"
            Sino
                Escribir "Es Negativo e Impar"
            FinSi
        FinSi
    FinSi
	
FinAlgoritmo